/* Main-thread UIKit only. No renderer hooks, display-link timer or GPU waits. */
@interface NativeReportView : UITextView
@property(nonatomic,copy) NSString *storedText;
@property(nonatomic,assign) BOOL displaying;
#if defined(NATIVE_INPUT_UI_TEST)
@property(nonatomic,assign) NSUInteger layoutWrites;
#endif
@end
@implementation NativeReportView
@synthesize storedText=_storedText;
@synthesize displaying=_displaying;
- (void)displayStoredText {
 [super setText:self.storedText];
#if defined(NATIVE_INPUT_UI_TEST)
 self.layoutWrites++;
#endif
}
- (void)setStoredText:(NSString *)text {_storedText=[(text?:@"") copy];if(self.displaying)[self displayStoredText];}
- (void)setDisplaying:(BOOL)value {_displaying=value;if(value)[self displayStoredText];}
@end

