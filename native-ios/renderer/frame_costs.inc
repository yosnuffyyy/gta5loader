static void frame_cost_observe(NativeGpu *g,uint64_t end,uint64_t interval){NativeMetrics *m=&g->metrics;FrameCost total={.frame=g->presents,.end=end,.interval=interval,.busy=m->frame_busy,.upload=m->frame_upload,.allocation=m->frame_alloc,.idle=m->idle_wait_ns,.drain=m->drain_flush_ns,.commands=g->ring.executed+1,.draws=g->draw.draws,.creates=g->draw.creates,.hits=g->draw.hits,.evictions=m->pipeline_evictions,.bytes=m->upload_bytes,.shader=m->windows[METRIC_SHADER].total_ns,.link=m->windows[METRIC_LINK].total_ns,.pipeline=m->windows[METRIC_PIPELINE].total_ns,.map=m->windows[METRIC_READBACK].total_ns,.completion=m->windows[METRIC_COMPLETION].total_ns,.shadow=m->windows[METRIC_SHADOW].total_ns,.post_compute=m->compute_seen};
 if(interval){FrameCost c=total;c.idle-=m->previous_cost.idle;c.drain-=m->previous_cost.drain;c.commands-=m->previous_cost.commands;c.draws-=m->previous_cost.draws;c.creates-=m->previous_cost.creates;c.hits-=m->previous_cost.hits;c.evictions-=m->previous_cost.evictions;c.bytes-=m->previous_cost.bytes;c.shader-=m->previous_cost.shader;c.link-=m->previous_cost.link;c.pipeline-=m->previous_cost.pipeline;c.map-=m->previous_cost.map;c.completion-=m->previous_cost.completion;c.shadow-=m->previous_cost.shadow;unsigned slot=m->cost_count<FRAME_COST_RECORDS?m->cost_count++:0;if(m->cost_count==FRAME_COST_RECORDS){for(unsigned i=1;i<FRAME_COST_RECORDS;i++)if(m->costs[i].interval<m->costs[slot].interval)slot=i;}if(!m->costs[slot].interval||c.interval>m->costs[slot].interval)m->costs[slot]=c;}
 m->previous_cost=total;
}
static void slow_command_observe(NativeGpu *g,uint32_t op,const uint8_t *p,uint32_t n,uint64_t end,uint64_t elapsed){NativeMetrics *m=&g->metrics;if(elapsed<8000000)return;unsigned slot=m->slow_count<FRAME_COST_RECORDS?m->slow_count++:0;if(m->slow_count==FRAME_COST_RECORDS)for(unsigned i=1;i<FRAME_COST_RECORDS;i++)if(m->slow[i].elapsed<m->slow[slot].elapsed)slot=i;if(m->slow[slot].elapsed>=elapsed)return;uint32_t bytes=op==13&&n>=12?gpu_word(p,11):(op==12||op==47)&&n>=3?gpu_word(p,2):0;Object *shader=object(g,op==32?g->shader[1]:op==39?g->shader[2]:0);uint64_t hash=shader&&shader->kind==14?((uint64_t)shader->meta[3]<<32)|shader->meta[2]:0;m->slow[slot]=(SlowCommand){g->presents+1,end,elapsed,m->command_flush_ns,hash,op,n?gpu_word(p,0):0,bytes};}
static void frame_cost_report(NativeGpu *g){if(!g->host->progress)return;NativeMetrics *m=&g->metrics;char line[620];g->host->progress(g->host->progress_context,"Bounded CPU cost records: up to eight worst PRESENT intervals and commands >=8ms. Includes loading. Nested categories overlap; idle is time waiting for the producer. These are not displayed frames or GPU execution times.");
 for(unsigned i=0;i<m->cost_count;i++){FrameCost *c=m->costs+i;snprintf(line,sizeof(line),"PRESENT cost #%llu at CPU monotonic %.3fs: interval %.3fms, commands/draws %llu/%llu, pipeline create/hit/evict %llu/%llu/%llu; handler/upload/allocation %.3f/%.3f/%.3fms; modules/link/pipeline/shadow %.3f/%.3f/%.3f/%.3fms; map/completion/producer-idle/drain-flush %.3f/%.3f/%.3f/%.3fms; upload %llu bytes; after-compute %u (not a scene marker).",(unsigned long long)c->frame,c->end/1e9,c->interval/1e6,(unsigned long long)c->commands,(unsigned long long)c->draws,(unsigned long long)c->creates,(unsigned long long)c->hits,(unsigned long long)c->evictions,c->busy/1e6,c->upload/1e6,c->allocation/1e6,c->shader/1e6,c->link/1e6,c->pipeline/1e6,c->shadow/1e6,c->map/1e6,c->completion/1e6,c->idle/1e6,c->drain/1e6,(unsigned long long)c->bytes,c->post_compute);g->host->progress(g->host->progress_context,line);}
 for(unsigned i=0;i<m->slow_count;i++){SlowCommand *c=m->slow+i;snprintf(line,sizeof(line),"Slow CPU command for PRESENT #%llu at %.3fs: %s source/arg0 %u bytes %u; total %.3fms, preceding mutation flush %.3fms; PS/CS %016llx (zero when unrelated). Flush is included in total.",(unsigned long long)c->frame,c->at/1e9,gpu_opcode_name(c->opcode),c->resource,c->bytes,c->elapsed/1e6,c->flush/1e6,(unsigned long long)c->shader);g->host->progress(g->host->progress_context,line);}
}
