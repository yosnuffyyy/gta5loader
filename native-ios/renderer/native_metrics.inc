 snprintf(text,sizeof(text),"Timing limits: no true GPU timestamps or engine-frame CPU hook; no sustained-gameplay classification. Readbacks %llu; callback post-completion sleeps avoided %llu; timing storage %zu bytes, latest 256 samples per series.",(unsigned long long)g->readbacks,(unsigned long long)g->metrics.callback_sleeps_avoided,sizeof(g->metrics));g->host->progress(g->host->progress_context,text);
