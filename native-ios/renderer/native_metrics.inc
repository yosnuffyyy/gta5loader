 snprintf(text,sizeof(text),"Submission context: queue submits %llu, draw batches %llu; protocol buffer/texture uploads %llu/%llu; byte-edge submits %llu, whole-copy submits %llu. Counts overlap and include preceding draw flushes; uniform uploads reported separately. No GPU timing inference.",(unsigned long long)g->submissions,(unsigned long long)g->draw.batches,(unsigned long long)(g->op_counts[12]+g->op_counts[47]),(unsigned long long)g->op_counts[13],(unsigned long long)g->upload_edge_dispatches,(unsigned long long)g->whole_copy_submissions);g->host->progress(g->host->progress_context,text);
 snprintf(text,sizeof(text),"Ordered immutable uploads: copies/bytes %llu/%llu; arena-capacity submits %llu; allocated CPU/GPU %u/%u KiB. Per-copy offsets never reused in an unsubmitted encoder; aggregate staging pressure remains bounded.",(unsigned long long)g->ordered_uploads,(unsigned long long)g->ordered_bytes,(unsigned long long)g->ordered_capacity_flushes,g->ordered_mirror?512:0,g->ordered_mirror?1024:0);g->host->progress(g->host->progress_context,text);
 for(unsigned i=0;i<g->metrics.pipeline_cost_count;i++){const PipelineCost *p=g->metrics.pipelines+i;snprintf(text,sizeof(text),"Pipeline CPU record %u: PRESENT %llu VS %016llx PS %016llx key %016llx API %.3fms; recent evicted-key match %u (64-key history incomplete). No GPU time or scene classification.",i+1,(unsigned long long)p->frame,(unsigned long long)p->vs,(unsigned long long)p->ps,(unsigned long long)p->key,p->elapsed/1e6,p->recreated);g->host->progress(g->host->progress_context,text);}
