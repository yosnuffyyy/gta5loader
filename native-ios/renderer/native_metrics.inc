/* GPU service thread only. These are CPU wall/CPU execution measurements,
   never GPU timestamps. Physical display intervals are measured in App.m. */
static uint64_t thread_cpu_ns(void){struct timespec t;if(clock_gettime(CLOCK_THREAD_CPUTIME_ID,&t))return 0;return (uint64_t)t.tv_sec*1000000000ull+t.tv_nsec;}
static void metrics_report(NativeGpu *g){if(!g->host->progress)return;static const char *names[]={"PRESENT submission intervals (not displayed FPS)","GPU-service CPU between PRESENTs (not engine CPU)","Command handler wall time per PRESENT (nested waits included)","Original WGSL module CPU wall (excludes linked variants)","Game DRAW pipeline API CPU wall","Readback submit/map CPU wall (not GPU execution)","Queue completion CPU wait","Upload handler wall per PRESENT","Resource create/destroy wall per PRESENT","Varying-link CPU wall (reflection and module creation)","Proven-inactive shadow variant module CPU wall"};
 char text[440];snprintf(text,sizeof(text),"Certified inactive-shadow variants: creates/hits/evictions %llu/%llu/%llu; at most 4 per live source shader. Active mismatches remain errors.",(unsigned long long)g->metrics.shadow_creates,(unsigned long long)g->metrics.shadow_hits,(unsigned long long)g->metrics.shadow_evictions);g->host->progress(g->host->progress_context,text);snprintf(text,sizeof(text),"Game pipeline cache: capacity %u; creates/hits/evictions %llu/%llu/%llu; unfinished frame handler/upload/allocation wall %.3f/%.3f/%.3f ms. Subcategories overlap handler wall; do not sum them.",DRAW_PIPELINES,(unsigned long long)g->draw.creates,(unsigned long long)g->draw.hits,(unsigned long long)g->metrics.pipeline_evictions,g->metrics.frame_busy/1e6,g->metrics.frame_upload/1e6,g->metrics.frame_alloc/1e6);g->host->progress(g->host->progress_context,text);for(unsigned i=0;i<METRIC_COUNT;i++){timing_text(g->metrics.windows+i,names[i],text,sizeof(text));g->host->progress(g->host->progress_context,text);}
 timing_text(&g->metrics.cold_frames,"First 64 PRESENT intervals (startup, includes loading)",text,sizeof(text));g->host->progress(g->host->progress_context,text);timing_text(&g->metrics.post_compute_frames,"Intervals after first compute (not a scene detector)",text,sizeof(text));g->host->progress(g->host->progress_context,text);
 snprintf(text,sizeof(text),"Timing limits: no true GPU timestamps or engine-frame CPU hook; no sustained-gameplay classification. Readbacks %llu; callback post-completion sleeps avoided %llu; timing storage %zu bytes, latest 256 samples per series.",(unsigned long long)g->readbacks,(unsigned long long)g->metrics.callback_sleeps_avoided,sizeof(g->metrics));g->host->progress(g->host->progress_context,text);
}
static void frame_cost_observe(NativeGpu *,uint64_t,uint64_t);
static void metrics_present(NativeGpu *g,uint64_t now){NativeMetrics *m=&g->metrics;uint64_t cpu=thread_cpu_ns();if(m->last_present){uint64_t interval=now-m->last_present;timing_add(&m->windows[METRIC_FRAME],interval);if(m->cold_frames.count<64)timing_add(&m->cold_frames,interval);if(m->compute_seen)timing_add(&m->post_compute_frames,interval);if(cpu&&m->last_cpu&&cpu>=m->last_cpu)timing_add(&m->windows[METRIC_CPU],cpu-m->last_cpu);timing_add(&m->windows[METRIC_BUSY],m->frame_busy);timing_add(&m->windows[METRIC_UPLOAD],m->frame_upload);timing_add(&m->windows[METRIC_ALLOC],m->frame_alloc);}
 frame_cost_observe(g,now,m->last_present?now-m->last_present:0);m->last_present=now;m->last_cpu=cpu;m->frame_busy=m->frame_upload=m->frame_alloc=0;if(g->draw.dispatches)m->compute_seen=true;
}
