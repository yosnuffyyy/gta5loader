/* GPU service thread only. These are CPU wall/CPU execution measurements,
   never GPU timestamps. Physical display intervals are measured in App.m. */
static uint64_t thread_cpu_ns(void){struct timespec t;if(clock_gettime(CLOCK_THREAD_CPUTIME_ID,&t))return 0;return (uint64_t)t.tv_sec*1000000000ull+t.tv_nsec;}
static void pipeline_cost_record(NativeGpu *g,const DrawKey *key,bool recreated,uint64_t elapsed){
 NativeMetrics *m=&g->metrics;unsigned slot=m->pipeline_cost_count;
 if(slot<8)m->pipeline_cost_count++;else {slot=0;for(unsigned i=1;i<8;i++)if(m->pipelines[i].elapsed<m->pipelines[slot].elapsed)slot=i;if(elapsed<=m->pipelines[slot].elapsed)return;}
 uint64_t fingerprint=UINT64_C(14695981039346656037);const uint8_t *bytes=(const void*)key;for(size_t i=0;i<sizeof(*key);i++){fingerprint^=bytes[i];fingerprint*=UINT64_C(1099511628211);}
 m->pipelines[slot]=(PipelineCost){elapsed,g->presents+1,((uint64_t)key->shader[1]<<32)|key->shader[0],((uint64_t)key->shader[3]<<32)|key->shader[2],fingerprint,recreated};
}
typedef struct {uint64_t objects,metadata,mirrors,buffers,textures,programs;} ResourceCensus;
static void resource_census(const void *key,const void *value,void *context){(void)key;const Object *o=value;ResourceCensus *c=context;c->objects++;c->metadata+=(uint64_t)o->words*4;if(o->shadow)c->mirrors+=o->size;if(o->buffer)c->buffers++;if(o->texture)c->textures++;if(o->program)c->programs++;}
