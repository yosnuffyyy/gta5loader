#touch-controls{position:fixed;inset:0;z-index:15;pointer-events:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;font:600 13px system-ui;color:#fff}
#touch-controls[hidden],#touch-toggle[hidden],#touch-rotate[hidden]{display:none}
#touch-controls button{box-sizing:border-box;pointer-events:auto;touch-action:none;min-width:44px;min-height:44px;border:1px solid #ffffff70;border-radius:13px;background:#10141da6;color:#fff;font:inherit;padding:5px;box-shadow:0 2px 8px #0003}
#touch-controls small{display:block;font:9px/1.25 system-ui;color:#eee;margin-top:2px}
#touch-controls button.pressed{background:#548269d9;border-color:#bcffd5}
.touch-stick{position:absolute;width:124px;height:124px;border:1px solid #ffffff70;border-radius:50%;background:#15202d60;pointer-events:auto;touch-action:none;display:grid;place-items:center}
.touch-stick span{position:absolute;top:14px;font:10px system-ui;letter-spacing:1px;opacity:.7}
.touch-stick i{display:block;width:48px;height:48px;border-radius:50%;background:#d6e4f070;border:1px solid #fff9;pointer-events:none}
.touch-move{left:max(22px,env(safe-area-inset-left));bottom:max(25px,env(safe-area-inset-bottom))}
.touch-look{right:max(180px,calc(env(safe-area-inset-right) + 165px));bottom:max(25px,env(safe-area-inset-bottom))}
.touch-shoulders{position:absolute;top:max(65px,calc(env(safe-area-inset-top) + 48px));display:flex;gap:9px}
.touch-shoulders button{width:82px;height:48px}
.touch-left{left:max(22px,env(safe-area-inset-left))}.touch-right{right:max(22px,env(safe-area-inset-right))}
.touch-menu{position:absolute;top:max(12px,env(safe-area-inset-top));left:50%;transform:translateX(-50%);display:flex;gap:8px}
.touch-menu button{width:58px}
.touch-face{position:absolute;right:max(12px,env(safe-area-inset-right));bottom:max(22px,env(safe-area-inset-bottom));width:154px;height:154px}
.touch-face button{position:absolute;width:58px;height:58px;border-radius:50%!important}
.touch-face .top{top:0;left:48px}.touch-face .left{left:0;top:48px}.touch-face .right{right:0;top:48px}.touch-face .bottom{bottom:0;left:48px}
.touch-dpad{position:absolute;left:max(164px,calc(env(safe-area-inset-left) + 142px));bottom:max(22px,env(safe-area-inset-bottom));width:132px;height:132px}
.touch-dpad button{position:absolute;width:44px;height:44px;font-size:18px!important}
.touch-dpad .up{top:0;left:44px}.touch-dpad .left{top:44px;left:0}.touch-dpad .right{top:44px;right:0}.touch-dpad .down{bottom:0;left:44px}
.touch-clicks{position:absolute;bottom:max(22px,env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);display:flex;gap:6px}
.touch-clicks button{width:54px}
#touch-toggle{position:fixed;z-index:21;top:max(12px,env(safe-area-inset-top));left:max(12px,env(safe-area-inset-left));min-height:40px;background:#161d26e6;color:#eee;border:1px solid #798492;border-radius:6px;padding:8px;font:12px system-ui;touch-action:manipulation}
#touch-rotate{display:none;position:fixed;z-index:14;top:38%;left:15%;width:70%;text-align:center;color:white;background:#101820c9;border-radius:8px;padding:10px;box-sizing:border-box;font:13px system-ui;pointer-events:none}
.mobile-device #canvas{touch-action:none;height:100dvh}.mobile-device #hud{top:125px;bottom:auto;left:20%;max-width:60%;font:11px/1.3 system-ui;z-index:18;text-align:center;text-shadow:0 1px 3px #000}
.mobile-device #offline-audio{top:max(12px,env(safe-area-inset-top))!important;right:max(12px,env(safe-area-inset-right))!important}
.mobile-device #controller-help{top:max(60px,calc(env(safe-area-inset-top) + 48px));right:50%;transform:translateX(50%);max-width:280px;font-size:11px}
.mobile-device #controller-help[open]{max-width:min(390px,90vw);max-height:calc(100dvh - 80px);z-index:25}
.mobile-device #modes{position:fixed!important;left:50%!important;bottom:max(28px,env(safe-area-inset-bottom));transform:translateX(-50%);z-index:6;background:#15191eed;padding:10px;border:1px solid #ffffff60;border-radius:10px;gap:10px;max-width:90vw}
.mobile-device #modes button{min-height:46px;font:14px system-ui;padding:5px 9px;touch-action:manipulation}
.mobile-device #modes .ls-key{display:none}
@media(orientation:portrait){#touch-rotate:not([hidden]){display:block}.touch-look{right:max(22px,env(safe-area-inset-right));bottom:195px}.touch-dpad{left:max(20px,env(safe-area-inset-left));bottom:195px}.touch-clicks{bottom:365px}.touch-shoulders{top:110px}.touch-shoulders button{width:clamp(62px,18vw,82px)}.touch-menu{top:60px}.mobile-device #controller-help{top:170px;max-width:90vw}.mobile-device #controller-help[open]{max-width:90vw}.mobile-device #modes{flex-wrap:wrap;justify-content:center}}
@media(orientation:landscape) and (max-width:740px){.touch-stick{width:100px;height:100px}.touch-look{right:174px}.touch-dpad{left:129px}.touch-clicks{bottom:160px}.touch-shoulders{top:70px}}
